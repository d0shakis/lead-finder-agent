# All optional. With no keys, Lead Finder uses offline rule-based scoring.

# --provider claude  (or auto)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# --provider openai  (or auto, if no Anthropic key)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --provider ollama  (free, local: https://ollama.com)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1
